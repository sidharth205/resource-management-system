# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API, and Project Settings -> Database).
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection strings (Project Settings -> Database -> Connection string)
# Use the "Transaction" pooler URL for DATABASE_URL and the "Session"/direct
# connection for DIRECT_URL (Prisma needs both for migrations to work reliably).
DATABASE_URL=
DIRECT_URL=
